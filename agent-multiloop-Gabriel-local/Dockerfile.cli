# =============================================================================
# Multi-Loop Math Agent - Dockerfile.cli (SLIM) v5.0
#
# Améliorations :
#   - Inclus toutes les composantes nécessaires au fonctionnement complet de Gabriel
#   - Ajout des dépendances système requises pour sockets, monitoring, scripts
#   - Maintien du modèle SLIM (aucune installation d’Isabelle ici)
#   - Optimisation du cache pip
#   - Compatibilité totale avec docker-compose v5.3
# =============================================================================

FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# ============================================================================
# Dépendances système minimales + utilitaires nécessaires pour Gabriel
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        git \
        build-essential \
        netcat-openbsd \
        procps \
        iproute2 \
        psmisc \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# ============================================================================
# User non-root
# ============================================================================
RUN useradd --create-home --shell /bin/bash agent
WORKDIR /home/agent/app

# ============================================================================
# Cache layer : requirements.txt en premier
# ============================================================================
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && find /usr/local/lib/python3.11 -name "*.pyc" -delete \
    && find /usr/local/lib/python3.11 -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# ============================================================================
# Code applicatif
# ============================================================================
COPY --chown=agent:agent main.py main_cli.py config.yaml config_optimized.yaml ./
COPY --chown=agent:agent src/ ./src/
COPY --chown=agent:agent theories/ ./theories/
COPY --chown=agent:agent memory/ ./memory/
COPY --chown=agent:agent scripts/ ./scripts/

# Helpers runtime
COPY --chown=agent:agent gabriel_launcher.py port_cleanup.py socket_cleanup.py ./

# ============================================================================
# Dossiers runtime
# ============================================================================
RUN mkdir -p data logs && chown -R agent:agent .

USER agent

VOLUME ["/home/agent/app/data", "/home/agent/app/logs"]

CMD ["python", "main_cli.py"]
