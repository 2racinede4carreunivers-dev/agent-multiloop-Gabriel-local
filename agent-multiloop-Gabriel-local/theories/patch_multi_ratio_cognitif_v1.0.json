      "contenu": "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nMULTI-RATIO DISPATCHER - Pipeline Cognitif Gabriel v7.6\n=======================================================\nDispatch multi-rapports 1/k pour une valeur de n commune.\n\nRapport typique    : 1/k = 1/2  (k=2)\nRapports non types : 1/k = 1/3..1/9\n\nAncrages n=10 (ANCHORS_N10) :\n  k=2 ->    29   k=3 ->   227   k=4 ->   947   k=5 ->  2999\n  k=6 ->  7529   k=7 -> 16519   k=8 -> 32327   k=9 -> 58337\n\nAuteur : Philippe Savard 2026\n\"\"\"\n\nfrom __future__ import annotations\nimport math\nfrom dataclasses import dataclass, field\nfrom typing import Dict, List, Optional\n\ntry:\n    from .suites_geometriques_niveau2 import (\n        CalculateurNiveau1Entiers, est_premier, valider_n, ORDRE_DIGAMMA\n    )\nexcept ImportError:\n    from suites_geometriques_niveau2 import (\n        CalculateurNiveau1Entiers, est_premier, valider_n, ORDRE_DIGAMMA\n    )\n\n# =============================================================================\n# CONSTANTES\n# =============================================================================\n\nANCHORS_N10: Dict[int, int] = {\n    2: 29, 3: 227, 4: 947, 5: 2999,\n    6: 7529, 7: 16519, 8: 32327, 9: 58337,\n}\nK_TYPIQUE = 2\nK_NON_TYPIQUES = [3, 4, 5, 6, 7, 8, 9]\nK_TOUS = [2, 3, 4, 5, 6, 7, 8, 9]\n\n# =============================================================================\n# STRUCTURES\n# =============================================================================\n\n@dataclass\nclass ResultatRatioUnique:\n    \"\"\"Resultat du pipeline pour un rapport 1/k et un n donne.\"\"\"\n    k: int\n    n: int\n    typique: bool\n    somme_A: int\n    somme_B: int\n    premier_ancre_n10: Optional[int]\n    premier_n: Optional[int]\n    digamma_calcule: Optional[int]\n    position_dans_P: Optional[int]\n    reconstruction_reussie: bool\n    message: str = \"\"\n\n    def __repr__(self):\n        s = \"OK\" if self.reconstruction_reussie else \"ECHEC\"\n        return f\"Ratio1/k(k={self.k}, n={self.n}, P={self.premier_n}, {s})\"\n\n\n@dataclass\nclass ResultatMultiRatio:\n    \"\"\"Resultat complet d'une requete multi-rapports 1/k pour un n commun.\"\"\"\n    n: int\n    liste_k: List[int]\n    resultats: Dict[int, ResultatRatioUnique] = field(default_factory=dict)\n\n    @property\n    def premiers_trouves(self):\n        return {k: r.premier_n for k, r in self.resultats.items()}\n\n    @property\n    def succes_total(self):\n        return all(r.reconstruction_reussie for r in self.resultats.values())\n\n    def rapport_texte(self):\n        sep = \"=\" * 72\n        L = [sep]\n        L.append(\n            f\" REQUETE MULTI-RATIO | n={self.n} \"\n            f\"| rapports: {['1/'+str(k) for k in self.liste_k]}\"\n        )\n        L.append(sep)\n        for k, r in self.resultats.items():\n            tag = \"typique\" if r.typique else \"non typique\"\n            st = \"PREMIER TROUVE\" if r.reconstruction_reussie else \"ECHEC\"\n            L.append(\n                f\"  1/{k} ({tag}) | S_A={r.somme_A} | S_B={r.somme_B} \"\n                f\"| ancre_n10={r.premier_ancre_n10} | P(n={r.n})={r.premier_n} | [{st}]\"\n            )\n            if r.message:\n                L.append(f\"    Note: {r.message}\")\n        L.append(sep)\n        L.append(f\" Succes global : {'OUI' if self.succes_total else 'PARTIEL/ECHEC'}\")\n        L.append(sep)\n        return \"\\n\".join(L)\n\n# =============================================================================\n# UTILITAIRES\n# =============================================================================\n\ndef _nieme_premier(pos: int) -> int:\n    \"\"\"Retourne le pos-ieme premier (1-base).\"\"\"\n    if pos < 1:\n        return 0\n    compte, candidat = 0, 1\n    while compte < pos:\n        candidat += 1\n        if est_premier(candidat):\n            compte += 1\n    return candidat\n\n\ndef _position_dans_P(p: int) -> int:\n    \"\"\"Position 1-based de p dans P. Retourne 0 si p n'est pas premier.\"\"\"\n    if not est_premier(p):\n        return 0\n    pos, c = 0, 1\n    while True:\n        c += 1\n        if est_premier(c):\n            pos += 1\n            if c == p:\n                return pos\n            if c > p:\n                return 0\n\n# =============================================================================\n# DISPATCHER\n# =============================================================================\n\nclass MultiRatioDispatcher:\n    \"\"\"\n    Dispatcher multi-rapports 1/k pour une valeur de n commune.\n\n    Usage:\n        d = MultiRatioDispatcher()\n        res = d.requete(n=10)\n        print(res.rapport_texte())\n\n        res = d.requete(n=12, liste_k=[2, 3, 7])\n        print(res.premiers_trouves)\n    \"\"\"\n\n    def __init__(self, verbose: bool = False):\n        self.verbose = verbose\n\n    def requete(self, n: int, liste_k=None) -> ResultatMultiRatio:\n        \"\"\"Lance le pipeline pour plusieurs rapports 1/k avec n commun.\"\"\"\n        valider_n(n)\n        if liste_k is None:\n            liste_k = K_TOUS\n        else:\n            invalides = [k for k in liste_k if k not in K_TOUS]\n            if invalides:\n                raise ValueError(\n                    f\"k non supporte(s): {invalides}. Valeurs acceptees: {K_TOUS}\"\n                )\n        res = ResultatMultiRatio(n=n, liste_k=list(liste_k))\n        for k in liste_k:\n            r = self._traiter_ratio(k=k, n=n)\n            res.resultats[k] = r\n            if self.verbose:\n                print(r)\n        return res\n\n    def _traiter_ratio(self, k: int, n: int) -> ResultatRatioUnique:\n        typique = (k == K_TYPIQUE)\n        calc = CalculateurNiveau1Entiers(k=k)\n        res_n  = calc.calculer(n)\n        res_10 = calc.calculer(10)\n        premier_ancre = self._ancre_n10(k=k, res_10=res_10)\n        premier_n = digamma_n = position = None\n        message = \"\"\n\n        if typique:\n            premier_n = _nieme_premier(n)\n            digamma_n = res_n.somme_B - premier_n * (k ** 6)\n            position  = n\n        else:\n            if premier_ancre is not None:\n                pos_ancre = _position_dans_P(premier_ancre)\n                pos_n = pos_ancre + (n - 10)\n                if pos_n >= 1:\n                    premier_n = _nieme_premier(pos_n)\n                    digamma_n = res_n.somme_B - premier_n * (k ** 6)\n                    position  = pos_n\n                else:\n                    message = (\n                        f\"n={n} trop petit pour progresser depuis \"\n                        f\"l'ancre (rang {pos_ancre} a n=10).\"\n                    )\n            else:\n                message = f\"Ancrage n=10 echoue pour k={k}.\"\n\n        ok = premier_n is not None and est_premier(premier_n)\n        return ResultatRatioUnique(\n            k=k, n=n, typique=typique,\n            somme_A=res_n.somme_A, somme_B=res_n.somme_B,\n            premier_ancre_n10=premier_ancre, premier_n=premier_n,\n            digamma_calcule=digamma_n, position_dans_P=position,\n            reconstruction_reussie=ok, message=message,\n        )\n\n    def _ancre_n10(self, k: int, res_10) -> Optional[int]:\n        \"\"\"Retourne le premier d'ancrage a n=10 via ANCHORS_N10 ou 4 Digamma.\"\"\"\n        if k in ANCHORS_N10:\n            return ANCHORS_N10[k]\n        k6 = k ** 6\n        for (pos_exp, signe) in ORDRE_DIGAMMA:\n            digamma = res_10.somme_A + signe * (k ** pos_exp)\n            num = res_10.somme_B - digamma\n            if num % k6 == 0:\n                P = num // k6\n                if est_premier(P):\n                    return P\n        return None\n\n    def tableau_comparatif(self, n: int, liste_k=None) -> str:\n        res = self.requete(n=n, liste_k=liste_k)\n        sep = \"-\" * 58\n        L = [f\"Tableau comparatif - n={n}\", sep,\n             f\"{'Rapport':>10} | {'Type':>11} | {'P(n)':>12} | {'Digamma':>14}\",\n             sep]\n        for k, r in res.resultats.items():\n            t = \"typique\" if r.typique else \"non typique\"\n            p = str(r.premier_n)  if r.premier_n  is not None else \"?\"\n            d = str(r.digamma_calcule) if r.digamma_calcule is not None else \"?\"\n            L.append(f\"{'1/'+str(k):>10} | {t:>11} | {p:>12} | {d:>14}\")\n        L.append(sep)\n        return \"\\n\".join(L)\n\n# =============================================================================\n# FONCTIONS PUBLIQUES\n# =============================================================================\n\ndef requete_multi_k(n: int, liste_k=None) -> ResultatMultiRatio:\n    \"\"\"\n    Requete multi-rapports 1/k pour un n commun.\n    Exemple:\n        res = requete_multi_k(n=10)\n        print(res.rapport_texte())\n        print(res.premiers_trouves)  # {2:29, 3:227, 4:947, ...}\n    \"\"\"\n    return MultiRatioDispatcher().requete(n=n, liste_k=liste_k)\n\n\ndef tableau_multi_k(n: int, liste_k=None) -> str:\n    \"\"\"Tableau comparatif des premiers pour les rapports 1/k.\"\"\"\n    return MultiRatioDispatcher().tableau_comparatif(n=n, liste_k=liste_k)\n\n\nif __name__ == \"__main__\":\n    import sys, io\n    try:\n        sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding=\"utf-8\", errors=\"replace\")\n    except Exception:\n        pass\n    print(\"\\n\" + \"=\" * 72)\n    print(\"  MULTI-RATIO DISPATCHER - Systeme convolutif spectral\")\n    print(\"  Test : tous les rapports 1/k pour n=10\")\n    print(\"=\" * 72)\n    res10 = requete_multi_k(n=10)\n    print(res10.rapport_texte())\n    print(tableau_multi_k(n=10))\n",
      "message": "Creation du module MultiRatioDispatcher v7.6"
    },
